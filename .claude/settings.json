{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npx vitest:*)",
      "Bash(npx oxlint:*)",
      "Bash(npx oxfmt:*)",
      "Bash(npx tsc:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)"
    ],
    "deny": [
      "Edit(./package.json)",
      "Edit(./package-lock.json)",
      "Edit(./tsconfig*.json)",
      "Edit(./.oxlintrc.json)",
      "Edit(./.oxfmtrc.json)",
      "Edit(./vite.config.*)",
      "Edit(./probity.config.ts)",
      "Edit(./src/setupTests.ts)",
      "Edit(./CLAUDE.md)",
      "Edit(./.claude/**)",
      "Edit(./.github/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "npx --no-install @nizos/probity --agent claude-code",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-and-lint.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
